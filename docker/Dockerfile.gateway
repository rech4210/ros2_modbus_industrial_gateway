FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libboost-all-dev \
    python3-colcon-common-extensions \
    python3-pytest \
    python3-pip \
    ros-jazzy-rmw-fastrtps-cpp \
    ros-jazzy-unique-identifier-msgs \
    && rm -rf /var/lib/apt/lists/*

# Ensure user 1000 exists
RUN if id -u 1000 >/dev/null 2>&1; then \
        EXISTING_USER=$(id -nu 1000); \
        usermod -l ros $EXISTING_USER || true; \
    else \
        groupadd -g 1000 ros && useradd -u 1000 -g ros -m -s /bin/bash ros; \
    fi

RUN echo "source /opt/ros/jazzy/setup.bash" >> /etc/bash.bashrc && \
    echo "if [ -f /ros2_ws/install/setup.bash ]; then source /ros2_ws/install/setup.bash; fi" >> /etc/bash.bashrc

WORKDIR /ros2_ws

COPY docker/gateway-entrypoint.sh /gateway-entrypoint.sh
RUN chmod +x /gateway-entrypoint.sh

RUN mkdir -p /ros2_ws/src /ros2_ws/build /ros2_ws/install /ros2_ws/log /run/plc && \
    chown -R 1000:1000 /ros2_ws /run/plc

USER 1000

ENTRYPOINT ["/gateway-entrypoint.sh"]
CMD ["bash"]
